#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "$0")/.."

echo "Installing dependencies..."
bundle install

echo ""
echo "Setup complete. Common commands:"
echo "  bin/console          # interactive REPL with the gem loaded"
echo "  bundle exec rspec    # run the test suite"
echo "  bundle exec rubocop  # run the linter"
echo "  bundle exec rake     # run specs + rubocop"
